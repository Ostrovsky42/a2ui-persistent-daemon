#!/usr/bin/env bash
set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$project_root"

command_name=${1:-}
port=${PORT:-8080}
session=${SESSION:-smoke}
preset=${PRESET:-dashboard}
socket=${SOCK:-}
runtime_dir=''
artifact_dir=''
daemon_pid=''
daemon_log=''

require() {
  command -v "$1" >/dev/null 2>&1 || {
    printf 'a2ui dev: required command not found: %s\n' "$1" >&2
    exit 127
  }
}

show_daemon_log() {
  if [[ -n "$daemon_log" && -f "$daemon_log" ]]; then
    printf '%s\n' 'a2ui dev: daemon log:' >&2
    sed -n '1,160p' "$daemon_log" >&2
  fi
}

cleanup() {
  status=$?
  trap - EXIT INT TERM
  if [[ $status -ne 0 ]]; then
    show_daemon_log
  fi
  if [[ -n "$daemon_pid" ]]; then
    kill "$daemon_pid" 2>/dev/null || true
    wait "$daemon_pid" 2>/dev/null || true
  fi
  if [[ -n "$artifact_dir" ]]; then
    rm -rf "$artifact_dir"
  fi
  exit "$status"
}

trap cleanup EXIT INT TERM

create_runtime() {
  artifact_dir=$(mktemp -d "${TMPDIR:-/tmp}/a2ui-dev.XXXXXX")
  chmod 700 "$artifact_dir"
  runtime_dir=$artifact_dir
  socket="$runtime_dir/a2ui.sock"
  daemon_log="$runtime_dir/a2uid.log"
}

start_daemon() {
  require go
  require curl
  go build -buildvcs=false -o "$artifact_dir/a2uid" ./cmd/a2uid
  "$artifact_dir/a2uid" -socket "$socket" -server "127.0.0.1:$port" -session "$session" >"$daemon_log" 2>&1 &
  daemon_pid=$!
  for _ in $(seq 1 100); do
    if [[ -S "$socket" ]]; then
      status=$(curl --silent --output /dev/null --write-out '%{http_code}' "http://127.0.0.1:$port/" || true)
      [[ "$status" == 405 ]] && return 0
    fi
    sleep 0.1
  done
  printf 'a2ui dev: daemon did not become ready on %s\n' "$socket" >&2
  return 1
}

smoke_http() {
  require curl
  require jq
  create_runtime
  start_daemon
  curl --fail-with-body --silent --show-error \
    -H 'Content-Type: application/json' \
    -H 'MCP-Protocol-Version: 2026-07-28' \
    -H 'Mcp-Method: a2ui/hello' \
    --data "{\"jsonrpc\":\"2.0\",\"id\":\"hello-1\",\"method\":\"a2ui/hello\",\"params\":{\"v\":1,\"session\":\"$session\",\"kind\":\"hello\",\"seq\":0,\"payload\":{\"versions\":[1],\"features\":[\"commit-barrier\"]}}}" \
    "http://127.0.0.1:$port/" | jq -e '.method == "a2ui/hello_ack"' >/dev/null
  status=$(curl --silent --show-error --output /dev/null --write-out '%{http_code}' \
    -H 'Content-Type: application/json' \
    -H 'MCP-Protocol-Version: 2026-07-28' \
    -H 'Mcp-Method: a2ui/operation' \
    --data "{\"jsonrpc\":\"2.0\",\"method\":\"a2ui/operation\",\"params\":{\"v\":1,\"session\":\"$session\",\"kind\":\"operation\",\"seq\":1,\"payload\":{\"v\":1,\"seq\":1,\"op\":\"upsert\",\"id\":\"smoke-title\",\"type\":\"text\",\"parent\":\"root\",\"props\":{\"text\":\"persistent daemon smoke\"}}}}" \
    "http://127.0.0.1:$port/")
  [[ "$status" == 204 ]] || { printf 'a2ui dev: expected operation HTTP 204, got %s\n' "$status" >&2; return 1; }
  printf '%s\n' 'smoke-http: PASS'
}

smoke_ipc() {
  require curl
  require jq
  require socat
  create_runtime
  start_daemon
  printf '%s\n' '{"v":1,"kind":"hello","client":"dev-smoke"}' | socat - "UNIX-CONNECT:$socket" >"$artifact_dir/ipc.ndjson"
  jq -e -s 'length == 2 and .[0].kind == "hello_ack" and .[1].kind == "snapshot"' "$artifact_dir/ipc.ndjson" >/dev/null
  printf '%s\n' 'smoke-ipc: PASS'
}

case "$command_name" in
  daemon)
    require go
    if [[ -z "$socket" ]]; then
      create_runtime
      printf 'a2ui dev: IPC socket: %s\n' "$socket" >&2
    else
      [[ -S "$socket" ]] && { printf 'a2ui dev: SOCK is already occupied: %s\n' "$socket" >&2; exit 1; }
      artifact_dir=$(mktemp -d "${TMPDIR:-/tmp}/a2ui-dev.XXXXXX")
      chmod 700 "$artifact_dir"
      daemon_log="$artifact_dir/a2uid.log"
    fi
    start_daemon
    wait "$daemon_pid"
    ;;
  client)
    require go
    [[ -n "$socket" ]] || { printf '%s\n' 'a2ui dev: client requires SOCK=/absolute/path/a2ui.sock' >&2; exit 2; }
    [[ -S "$socket" ]] || { printf 'a2ui dev: no Unix socket at %s\n' "$socket" >&2; exit 2; }
    exec go run -buildvcs=false ./cmd/a2ui -socket "$socket" -preset "$preset"
    ;;
  smoke-http) smoke_http ;;
  smoke-ipc) smoke_ipc ;;
  *)
    printf '%s\n' 'usage: scripts/dev/a2ui {daemon|client|smoke-http|smoke-ipc}' >&2
    exit 2
    ;;
esac
